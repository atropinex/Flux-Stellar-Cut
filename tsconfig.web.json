{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "scripts/ui/**/*.ts",
    "scripts/ui/**/*.tsx",
    "scripts/global.d.ts",
    "scripts/vite-end.d.ts",
    "scripts/common/CommonInteface.ts",
    "scripts/common/lumen/Lumen*.ts",
    "scripts/common/utils/*.ts"
  ],
  "exclude": ["scripts/ui/mainindex.ts"]
}
